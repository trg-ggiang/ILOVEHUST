generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               Int            @id @default(autoincrement())
  email            String         @unique
  phone            String?        @unique
  passwordHash     String         @map("password_hash")
  role             Int            @default(1) // 0 = admin, 1 = student
  isActive         Boolean        @default(true) @map("is_active")
  lastLoginAt      DateTime?      @map("last_login_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  studentProfile   StudentProfile?
  gradeRecords     GradeRecord[]

  @@map("users")
}

model Major {
  id            Int              @id @default(autoincrement())
  majorCode     String           @unique @map("major_code")
  majorName     String           @map("major_name")
  facultyName   String?          @map("faculty_name")
  createdAt     DateTime         @default(now()) @map("created_at")

  studentProfiles StudentProfile[]

  @@map("majors")
}

model StudentProfile {
  id               Int        @id @default(autoincrement())
  userId           Int        @unique @map("user_id")
  majorId          Int?       @map("major_id")
  fullName         String     @map("full_name")
  studentCode      String?    @unique @map("student_code")
  schoolYear       Int?       @map("school_year")
  gpa              Decimal?   @db.Decimal(3, 2)
  cpa              Decimal?   @db.Decimal(3, 2)
  profileCompleted Boolean    @default(false) @map("profile_completed")
  cttConnected     Boolean    @default(false) @map("ctt_connected")
  avatarUrl        String?    @map("avatar_url")
  bio              String?
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  major            Major?     @relation(fields: [majorId], references: [id])

  @@map("student_profiles")
}

model Semester {
  id            Int           @id @default(autoincrement())
  semesterCode  String        @unique @map("semester_code")
  semesterName  String        @map("semester_name")
  academicYear  String        @map("academic_year")
  termNumber    Int           @map("term_number")
  startDate     DateTime?     @map("start_date") @db.Date
  endDate       DateTime?     @map("end_date") @db.Date
  isCurrent     Boolean       @default(false) @map("is_current")
  createdAt     DateTime      @default(now()) @map("created_at")

  gradeRecords  GradeRecord[]

  @@map("semesters")
}

model Course {
  id            Int           @id @default(autoincrement())
  courseCode    String        @unique @map("course_code")
  courseName    String        @map("course_name")
  credits       Int
  createdAt     DateTime      @default(now()) @map("created_at")

  gradeRecords  GradeRecord[]

  @@map("courses")
}

model GradeRecord {
  id               Int        @id @default(autoincrement())
  userId           Int        @map("user_id")
  semesterId       Int        @map("semester_id")
  courseId         Int        @map("course_id")
  processScore     Decimal?   @map("process_score") @db.Decimal(4, 2)
  examScore        Decimal?   @map("exam_score") @db.Decimal(4, 2)
  score10          Decimal?   @map("score_10") @db.Decimal(4, 2)
  score4           Decimal?   @map("score_4") @db.Decimal(3, 2)
  letterScore      String?    @map("letter_score")
  resultStatus     String?    @map("result_status")
  importedFromCtt  Boolean    @default(false) @map("imported_from_ctt")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  semester         Semester   @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  course           Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, semesterId, courseId])
  @@map("grade_records")
}